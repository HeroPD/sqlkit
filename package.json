{
  "name": "sqlkit-studio",
  "productName": "SqlKit Studio",
  "private": true,
  "version": "0.1.0",
  "description": "SqlKit Studio multi-database desktop workbench",
  "author": "Munkhbaatar <munkhbaatar@opl.mn>",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "smoke": "npm run build && electron . --smoke-test",
    "preview": "vite preview",
    "pack": "npm run build && dotenv -e .env -- electron-builder --dir",
    "dist": "npm run build && dotenv -e .env -- electron-builder"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^10.0.1",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "^1.15.5",
    "codemirror": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^10.5.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lit": "^3.3.3",
    "sql-formatter": "^15.8.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "mssql": "12.7.0",
    "mysql2": "^3.22.5",
    "pg": "^8.21.0",
    "ssh2": "^1.17.0",
    "tedious": "20.0.0"
  },
  "overrides": {
    "tedious": "20.0.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "ssh2@1.17.0": true
  }
}
