# Integration tests against a real Postgres run only when this is set; without
# it electron/db/*.integration.test.ts skip. Copy this file to .env (gitignored).
TEST_DATABASE_URL=postgres://postgres:pass@localhost:5438/testsqlkit?sslmode=disable

# Spin up a throwaway server matching the URL above:
#   docker run --rm -d --name sqlkit-test-pg -p 5438:5432 \
#     -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=testsqlkit postgres:18

# Same for MySQL (root so create/drop database and all-databases mode work):
# TEST_MYSQL_URL=mysql://root:root@localhost:3306/testsqlkit
#   docker run --rm -d --name sqlkit-test-mysql -p 3306:3306 \
#     -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=testsqlkit mysql:8

# Same for SQL Server (sa; the suite creates/drops its own sqlkit_it_mssql db):
# TEST_MSSQL_URL=mssql://sa:LocalStrongPassword123!@localhost:1433/master
#   docker run --rm -d --name sqlkit-test-mssql -p 1433:1433 -e ACCEPT_EULA=Y \
#     -e MSSQL_SA_PASSWORD='LocalStrongPassword123!' mcr.microsoft.com/mssql/server:2022-latest

# The same Postgres reached through a transaction-pooling proxy, so the suite can
# cover what a direct connection cannot: such an endpoint hands out a synthetic
# BackendKeyData, so pg_cancel_backend cannot reach the real backend and only a
# wire-protocol CancelRequest interrupts a query. Point this at PgBouncer (or
# Supavisor / RDS Proxy) in front of TEST_DATABASE_URL:
# TEST_POOLED_DATABASE_URL=postgres://postgres:pass@127.0.0.1:6432/testsqlkit?sslmode=disable
#   docker run --rm -d --name sqlkit-test-pgbouncer -p 6432:6432 \
#     --network <the postgres container's network> \
#     -e DB_HOST=<postgres container ip> -e DB_PORT=5432 \
#     -e DB_USER=postgres -e DB_PASSWORD=pass -e DB_NAME=testsqlkit \
#     -e POOL_MODE=transaction -e AUTH_TYPE=plain -e LISTEN_PORT=6432 edoburu/pgbouncer

# macOS release notarization. Use either Apple ID credentials:
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID1234

# Or App Store Connect API key credentials:
# APPLE_API_KEY=/absolute/path/AuthKey_ABC123.p8
# APPLE_API_KEY_ID=ABC123
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
