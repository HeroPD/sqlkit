# Integration tests against a real Postgres run only when this is set; without
# it electron/db/*.integration.test.ts skip. Copy this file to .env (gitignored).
TEST_DATABASE_URL=postgres://postgres:pass@localhost:5438/testsqlkit?sslmode=disable

# Spin up a throwaway server matching the URL above:
#   docker run --rm -d --name sqlkit-test-pg -p 5438:5432 \
#     -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=testsqlkit postgres:18

# macOS release notarization. Use either Apple ID credentials:
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID1234

# Or App Store Connect API key credentials:
# APPLE_API_KEY=/absolute/path/AuthKey_ABC123.p8
# APPLE_API_KEY_ID=ABC123
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
